    field single[] float32_values
    field double[] float64_values
    field int8[] int8_values
    field uint8[] uint8_values
    field int16[] int16_values
    field uint16[] uint16_values
    field int32[] int32_values
    field uint32[] uint32_values
    field int64[] int64_values
    field uint64[] uint64_values
    field string{list} string_values
