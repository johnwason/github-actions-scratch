From 91ce8b3b53d13bf7eb845cdcad7e91ce34c2ef20 Mon Sep 17 00:00:00 2001
From: John Wason <wason@wasontech.com>
Date: Sun, 15 Nov 2026 11:56:18 -0500
Subject: [PATCH 4/4] SWIG: release directors of closed pipe endpoints, wire
 connections and wire/pipe subscriptions

[skip ci] (pushed to github-actions-scratch for the Go bindings CI only)

A director held by a wrapped object keeps the wrapping language's object
alive (it is referenced from the language's object heap until the director
is released). Pipe endpoints and wire connections released their director
only in Close/AsyncClose, so endpoints closed by the peer or by a
disconnect were never collectable; wire and pipe subscriptions released it
only in their destructor, which the wrapping object itself prevents.
Release the director after the closed callback, and in new Close methods
of WrappedWireSubscription/WrappedPipeSubscription. Binding code only; the
C++ library ABI is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 SWIG/RobotRaconteurWrapped.cpp | 37 ++++++++++++++++++++++++++++++++++
 SWIG/RobotRaconteurWrapped.h   |  4 ++++
 2 files changed, 41 insertions(+)

diff --git a/SWIG/RobotRaconteurWrapped.cpp b/SWIG/RobotRaconteurWrapped.cpp
index 9f8f0575..5cee12b4 100644
--- a/SWIG/RobotRaconteurWrapped.cpp
+++ b/SWIG/RobotRaconteurWrapped.cpp
@@ -1014,6 +1014,15 @@ void WrappedPipeEndpoint::fire_PipeEndpointClosedCallback()
     {}
 
     DIRECTOR_CALL3(WrappedPipeEndpointDirector, RR_Director2->PipeEndpointClosedCallback());
+
+    // No events follow a close: release the director so the wrapping
+    // language can collect its endpoint object (also when the endpoint is
+    // closed by the peer or by a disconnect, not by Close()).
+    boost::shared_ptr<WrappedPipeEndpointDirector> director1;
+    {
+        boost::unique_lock<boost::shared_mutex> lock(RR_Director_lock);
+        director1.swap(RR_Director);
+    }
 }
 
 void WrappedPipeEndpoint::fire_PacketReceivedEvent()
@@ -1391,6 +1400,14 @@ void WrappedWireConnection::fire_WireClosedCallback()
     {}
 
     DIRECTOR_CALL3(WrappedWireConnectionDirector, RR_Director2->WireConnectionClosedCallback());
+
+    // No events follow a close: release the director (see
+    // WrappedPipeEndpoint::fire_PipeEndpointClosedCallback).
+    boost::shared_ptr<WrappedWireConnectionDirector> director1;
+    {
+        boost::unique_lock<boost::shared_mutex> lock(RR_Director_lock);
+        director1.swap(RR_Director);
+    }
 }
 
 void WrappedWireConnection::SetRRDirector(WrappedWireConnectionDirector* director, int32_t id)
@@ -4185,6 +4202,16 @@ bool WrappedWireSubscription::TryGetInValue(WrappedService_typed_packet& val, Ti
     return ret;
 }
 
+void WrappedWireSubscription::Close()
+{
+    boost::shared_ptr<WrappedWireSubscriptionDirector> director1;
+    {
+        boost::unique_lock<boost::shared_mutex> lock(RR_Director_lock);
+        director1.swap(RR_Director);
+    }
+    WireSubscriptionBase::Close();
+}
+
 void WrappedWireSubscription::SetRRDirector(WrappedWireSubscriptionDirector* director, int32_t id)
 {
     boost::unique_lock<boost::shared_mutex> lock(RR_Director_lock);
@@ -4295,6 +4322,16 @@ bool WrappedPipeSubscription::TryReceivePacketWait(WrappedService_typed_packet&
     return ret;
 }
 
+void WrappedPipeSubscription::Close()
+{
+    boost::shared_ptr<WrappedPipeSubscriptionDirector> director1;
+    {
+        boost::unique_lock<boost::shared_mutex> lock(RR_Director_lock);
+        director1.swap(RR_Director);
+    }
+    PipeSubscriptionBase::Close();
+}
+
 void WrappedPipeSubscription::SetRRDirector(WrappedPipeSubscriptionDirector* director, int32_t id)
 {
     boost::unique_lock<boost::shared_mutex> lock(RR_Director_lock);
diff --git a/SWIG/RobotRaconteurWrapped.h b/SWIG/RobotRaconteurWrapped.h
index 24278749..45b01e56 100644
--- a/SWIG/RobotRaconteurWrapped.h
+++ b/SWIG/RobotRaconteurWrapped.h
@@ -2055,6 +2055,8 @@ class WrappedWireSubscription : public WireSubscriptionBase
     bool TryGetInValue(WrappedService_typed_packet& val, TimeSpec* time = NULL);
 
     void SetRRDirector(WrappedWireSubscriptionDirector* director, int32_t id);
+    // Releases the director, then closes the subscription.
+    void Close();
 
   protected:
     RR_OVIRTUAL void fire_WireValueChanged(const RR_INTRUSIVE_PTR<RRValue>& value, const TimeSpec& time,
@@ -2103,6 +2105,8 @@ class WrappedPipeSubscription : public PipeSubscriptionBase
                               bool peek = false);
 
     void SetRRDirector(WrappedPipeSubscriptionDirector* director, int32_t id);
+    // Releases the director, then closes the subscription.
+    void Close();
 
   protected:
     RR_OVIRTUAL void fire_PipePacketReceived() RR_OVERRIDE;
