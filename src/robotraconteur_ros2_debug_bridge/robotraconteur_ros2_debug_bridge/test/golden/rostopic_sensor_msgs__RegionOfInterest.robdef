service rostopic_sensor_msgs__RegionOfInterest

stdver 0.10

import rosmsg_sensor_msgs__RegionOfInterest

object subscriber
    pipe rosmsg_sensor_msgs__RegionOfInterest.RegionOfInterest subscriberpipe [readonly]
    wire rosmsg_sensor_msgs__RegionOfInterest.RegionOfInterest subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_sensor_msgs__RegionOfInterest.RegionOfInterest m)
    pipe rosmsg_sensor_msgs__RegionOfInterest.RegionOfInterest publisherpipe [writeonly]
    wire rosmsg_sensor_msgs__RegionOfInterest.RegionOfInterest publisherwire [writeonly]
end
