service rostopic_sensor_msgs__LaserEcho

stdver 0.10

import rosmsg_sensor_msgs__LaserEcho

object subscriber
    pipe rosmsg_sensor_msgs__LaserEcho.LaserEcho subscriberpipe [readonly]
    wire rosmsg_sensor_msgs__LaserEcho.LaserEcho subscriberwire [readonly]
