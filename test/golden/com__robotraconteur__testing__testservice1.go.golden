				_, rr_err := rr_b.CallbackCall("cb_errtest", rr_ep, &rr_b2)
				return rr_err
			}, nil
		})
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w1", rr.ArrayCodec[float64](0, false)); rr_err != nil {
		return rr_err
