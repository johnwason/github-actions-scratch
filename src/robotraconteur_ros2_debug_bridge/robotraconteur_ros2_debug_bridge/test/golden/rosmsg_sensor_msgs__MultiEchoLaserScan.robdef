service rosmsg_sensor_msgs__MultiEchoLaserScan

stdver 0.10

import rosmsg_std_msgs__Header
import rosmsg_sensor_msgs__LaserEcho

struct MultiEchoLaserScan
    field rosmsg_std_msgs__Header.Header header
    field single angle_min
    field single angle_max
    field single angle_increment
    field single time_increment
    field single scan_time
    field single range_min
    field single range_max
    field rosmsg_sensor_msgs__LaserEcho.LaserEcho{list} ranges
    field rosmsg_sensor_msgs__LaserEcho.LaserEcho{list} intensities
end
