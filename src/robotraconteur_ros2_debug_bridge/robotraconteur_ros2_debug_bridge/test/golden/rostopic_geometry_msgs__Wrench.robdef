service rostopic_geometry_msgs__Wrench

stdver 0.10

import rosmsg_geometry_msgs__Wrench

object subscriber
    pipe rosmsg_geometry_msgs__Wrench.Wrench subscriberpipe [readonly]
    wire rosmsg_geometry_msgs__Wrench.Wrench subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_geometry_msgs__Wrench.Wrench m)
    pipe rosmsg_geometry_msgs__Wrench.Wrench publisherpipe [writeonly]
    wire rosmsg_geometry_msgs__Wrench.Wrench publisherwire [writeonly]
end
