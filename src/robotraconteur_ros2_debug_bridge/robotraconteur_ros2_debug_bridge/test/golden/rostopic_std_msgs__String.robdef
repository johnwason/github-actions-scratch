    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_std_msgs__String.String m)
    pipe rosmsg_std_msgs__String.String publisherpipe [writeonly]
    wire rosmsg_std_msgs__String.String publisherwire [writeonly]
