service rostopic_std_msgs__Byte

stdver 0.10

import rosmsg_std_msgs__Byte

object subscriber
    pipe rosmsg_std_msgs__Byte.Byte subscriberpipe [readonly]
    wire rosmsg_std_msgs__Byte.Byte subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_std_msgs__Byte.Byte m)
    pipe rosmsg_std_msgs__Byte.Byte publisherpipe [writeonly]
    wire rosmsg_std_msgs__Byte.Byte publisherwire [writeonly]
end
