# rrgo_collect_link_flags(<out-var> <target>)
#
# Produces the list of linker arguments (with generator expressions) needed to
# link <target> into a Go program with cgo. Walks INTERFACE_LINK_LIBRARIES of
# the target and its dependencies: targets become $<TARGET_LINKER_FILE:...>,
# plain names become -l<name>, paths are kept as is. cmake/gen_cgo_flags.py
# then rewrites shared library paths into the -L/-l form accepted by cgo.

function(_rrgo_walk_link item out_var)
    set(result ${${out_var}})
    if(item MATCHES "^\\$<LINK_ONLY:(.*)>$")
        set(item "${CMAKE_MATCH_1}")
    endif()
    if(item MATCHES "^\\$<")
        # Other generator expressions (e.g. config dependent) are kept verbatim
        list(APPEND result "${item}")
    elseif(TARGET ${item})
        get_target_property(_aliased ${item} ALIASED_TARGET)
        if(_aliased)
            set(item ${_aliased})
        endif()
        list(FIND _RRGO_VISITED ${item} _idx)
        if(_idx GREATER -1)
            set(${out_var} ${result} PARENT_SCOPE)
            return()
        endif()
        list(APPEND _RRGO_VISITED ${item})
        set(_RRGO_VISITED ${_RRGO_VISITED} PARENT_SCOPE)
        get_target_property(_type ${item} TYPE)
        if(NOT _type STREQUAL "INTERFACE_LIBRARY")
            list(APPEND result "$<TARGET_LINKER_FILE:${item}>")
        endif()
        get_target_property(_deps ${item} INTERFACE_LINK_LIBRARIES)
        if(NOT _type STREQUAL "INTERFACE_LIBRARY" AND NOT _type STREQUAL "UNKNOWN_LIBRARY")
            get_target_property(_ldeps ${item} LINK_LIBRARIES)
            if(_ldeps AND NOT _type MATCHES "SHARED")
                list(APPEND _deps ${_ldeps})
            endif()
        endif()
        if(_deps)
            foreach(d ${_deps})
                _rrgo_walk_link("${d}" result)
            endforeach()
            set(_RRGO_VISITED ${_RRGO_VISITED} PARENT_SCOPE)
        endif()
    elseif(item MATCHES "^-")
        list(APPEND result "${item}")
    elseif(IS_ABSOLUTE "${item}")
        list(APPEND result "${item}")
    elseif(item)
        list(APPEND result "-l${item}")
    endif()
    set(${out_var} ${result} PARENT_SCOPE)
endfunction()

function(rrgo_collect_link_flags out_var target)
    set(_RRGO_VISITED "")
    set(flags "")
    _rrgo_walk_link(${target} flags)
    list(REMOVE_DUPLICATES flags)
    set(${out_var} ${flags} PARENT_SCOPE)
endfunction()
