func (rr_s *testroot3Skel) RRInit(rr_b *rr.SkelBase) error {
	rr_s.b = rr_b
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "unreliable1", rr.ScalarCodec[int32]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_unreliable1(*rr.Pipe[int32]) }); rr_ok {
		rr_set.Set_unreliable1(rr_p)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "peekwire", rr.ScalarCodec[int32]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_peekwire(*rr.Wire[int32]) }); rr_ok {
		rr_set.Set_peekwire(rr_w)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "pokewire", rr.ScalarCodec[int32]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_pokewire(*rr.Wire[int32]) }); rr_ok {
		rr_set.Set_pokewire(rr_w)
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "p1", rr.ArrayCodec[int32](3, false)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_p1(*rr.Pipe[[]int32]) }); rr_ok {
		rr_set.Set_p1(rr_p)
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "p2", rr.ArrayCodec[int32](3, true)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_p2(*rr.Pipe[[]int32]) }); rr_ok {
		rr_set.Set_p2(rr_p)
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "p3", rr.MultiDimArrayCodec[int32](2, 2)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_p3(*rr.Pipe[*rr.MultiDimArray[int32]]) }); rr_ok {
		rr_set.Set_p3(rr_p)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w1", rr.ArrayCodec[int32](6, false)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_w1(*rr.Wire[[]int32]) }); rr_ok {
		rr_set.Set_w1(rr_w)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w2", rr.ArrayCodec[int32](6, true)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_w2(*rr.Wire[[]int32]) }); rr_ok {
		rr_set.Set_w2(rr_w)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w3", rr.MultiDimArrayCodec[int32](3, 2)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_w3(*rr.Wire[*rr.MultiDimArray[int32]]) }); rr_ok {
		rr_set.Set_w3(rr_w)
	}
	return nil
}

