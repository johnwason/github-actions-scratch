service rostopic_sensor_msgs__Imu

stdver 0.10

import rosmsg_sensor_msgs__Imu

object subscriber
    pipe rosmsg_sensor_msgs__Imu.Imu subscriberpipe [readonly]
    wire rosmsg_sensor_msgs__Imu.Imu subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_sensor_msgs__Imu.Imu m)
    pipe rosmsg_sensor_msgs__Imu.Imu publisherpipe [writeonly]
    wire rosmsg_sensor_msgs__Imu.Imu publisherwire [writeonly]
end
