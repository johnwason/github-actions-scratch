service rosmsg_nav_msgs__Odometry

stdver 0.10

import rosmsg_std_msgs__Header
import rosmsg_geometry_msgs__PoseWithCovariance
import rosmsg_geometry_msgs__TwistWithCovariance

struct Odometry
    field rosmsg_std_msgs__Header.Header header
    field string child_frame_id
    field rosmsg_geometry_msgs__PoseWithCovariance.PoseWithCovariance pose
    field rosmsg_geometry_msgs__TwistWithCovariance.TwistWithCovariance twist
end
