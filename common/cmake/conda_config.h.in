/**
 * @file conda_config.h
 * @brief Build options of tesseract_common related to conda package support (generated by CMake)
 */
#ifndef TESSERACT_COMMON_CONDA_CONFIG_H
#define TESSERACT_COMMON_CONDA_CONFIG_H

/** @brief Defined when tesseract_common can read resources from .conda packages (TESSERACT_ENABLE_CONDA_ARCHIVES) */
#cmakedefine TESSERACT_COMMON_HAS_CONDA_ARCHIVES_CONFIG
#if defined(TESSERACT_COMMON_HAS_CONDA_ARCHIVES_CONFIG) && !defined(TESSERACT_COMMON_HAS_CONDA_ARCHIVES)
#define TESSERACT_COMMON_HAS_CONDA_ARCHIVES 1
#endif

#endif  // TESSERACT_COMMON_CONDA_CONFIG_H
