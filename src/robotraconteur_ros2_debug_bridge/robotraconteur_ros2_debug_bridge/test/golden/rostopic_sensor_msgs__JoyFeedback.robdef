service rostopic_sensor_msgs__JoyFeedback

stdver 0.10

import rosmsg_sensor_msgs__JoyFeedback

object subscriber
    pipe rosmsg_sensor_msgs__JoyFeedback.JoyFeedback subscriberpipe [readonly]
    wire rosmsg_sensor_msgs__JoyFeedback.JoyFeedback subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_sensor_msgs__JoyFeedback.JoyFeedback m)
    pipe rosmsg_sensor_msgs__JoyFeedback.JoyFeedback publisherpipe [writeonly]
    wire rosmsg_sensor_msgs__JoyFeedback.JoyFeedback publisherwire [writeonly]
end
