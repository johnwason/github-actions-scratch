	obj Testroot
	b   *rr.SkelBase
}

func (rr_s *testrootSkel) RRInit(rr_b *rr.SkelBase) error {
	rr_s.b = rr_b
	if rr_ev := rr_s.obj.Get_ev1(); rr_ev != nil {
		rr_b.RRAddEventConnection(rr_ev.Connect(func() {
			var rr_b2 rr.ElementBuilder
			_ = rr_b.DispatchEvent("ev1", &rr_b2)
		}))
	}
	if rr_ev := rr_s.obj.Get_ev2(); rr_ev != nil {
		rr_b.RRAddEventConnection(rr_ev.Connect(func(d1 float64, s2 *Teststruct2) {
			var rr_b2 rr.ElementBuilder
			rr.PackField(&rr_b2, "d1", d1, rr.ScalarCodec[float64]())
			rr.PackField(&rr_b2, "s2", s2, rr.StructureCodec[Teststruct2]())
			_ = rr_b.DispatchEvent("ev2", &rr_b2)
		}))
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "p1", rr.ArrayCodec[float64](0, false)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_p1(*rr.Pipe[[]float64]) }); rr_ok {
		rr_set.Set_p1(rr_p)
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "p2", rr.StructureCodec[Teststruct2]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_p2(*rr.Pipe[*Teststruct2]) }); rr_ok {
		rr_set.Set_p2(rr_p)
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "broadcastpipe", rr.ScalarCodec[float64]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_broadcastpipe(*rr.Pipe[float64]) }); rr_ok {
		rr_set.Set_broadcastpipe(rr_p)
	}
	if rr_cb := rr_s.obj.Get_cb1(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func() error, error) {
			return func() error {
				var rr_b2 rr.ElementBuilder
				_, rr_err := rr_b.CallbackCall("cb1", rr_ep, &rr_b2)
				return rr_err
			}, nil
		})
	}
	if rr_cb := rr_s.obj.Get_cb2(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func(d1 float64, d2 float64) error, error) {
			return func(d1 float64, d2 float64) error {
				var rr_b2 rr.ElementBuilder
				rr.PackField(&rr_b2, "d1", d1, rr.ScalarCodec[float64]())
				rr.PackField(&rr_b2, "d2", d2, rr.ScalarCodec[float64]())
				_, rr_err := rr_b.CallbackCall("cb2", rr_ep, &rr_b2)
				return rr_err
			}, nil
		})
	}
	if rr_cb := rr_s.obj.Get_cb3(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func(d1 float64, d2 float64) (float64, error), error) {
			return func(d1 float64, d2 float64) (float64, error) {
				var rr_b2 rr.ElementBuilder
				rr.PackField(&rr_b2, "d1", d1, rr.ScalarCodec[float64]())
				rr.PackField(&rr_b2, "d2", d2, rr.ScalarCodec[float64]())
				rr_ret, rr_err := rr_b.CallbackCall("cb3", rr_ep, &rr_b2)
				if rr_err != nil {
					var rr_zero float64
					return rr_zero, rr_err
				}
				return rr.UnpackReturn(rr_ret, rr.ScalarCodec[float64]())
			}, nil
		})
	}
	if rr_cb := rr_s.obj.Get_cb_meaning_of_life(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func() (int32, error), error) {
			return func() (int32, error) {
				var rr_b2 rr.ElementBuilder
				rr_ret, rr_err := rr_b.CallbackCall("cb_meaning_of_life", rr_ep, &rr_b2)
				if rr_err != nil {
