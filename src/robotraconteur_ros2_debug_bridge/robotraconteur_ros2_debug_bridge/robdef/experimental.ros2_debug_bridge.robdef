# Root service of robotraconteur_ros2_debug_bridge (PLAN.md 2.2, 2.3).
# Grows by milestone; members are only ever added, never changed, so
# clients of earlier versions keep working.
service experimental.ros2_debug_bridge

stdver 0.10

# B5: the ROS graph as the exposure rules allow it to be seen. Names are
# fully qualified.
struct GraphTopic
    field string name
    field string{list} types
    field int32 publisher_count
    field int32 subscription_count
end

struct GraphService
    field string name
    field string{list} types
end

struct GraphAction
    field string name
    field string{list} types
end

struct Graph
    # Increases whenever what is visible changes.
    field uint64 version
    field string{list} nodes
    field GraphTopic{list} topics
    field GraphService{list} services
    field GraphAction{list} actions
end

# One publisher or subscription of a topic, with its QoS. node_name and
# node_namespace are empty for a node the exposure rules hide.
struct TopicEndpoint
    field string node_name
    field string node_namespace
    field string topic_type
    # "publisher" or "subscription"
    field string endpoint_type
    # "reliable", "best_effort", "system_default", "unknown", ...
    field string reliability
    field string durability
    field string history
    field uint64 depth
    # Seconds; 0 is the default (infinite).
    field double deadline
    field double lifespan
    field string liveliness
    field double liveliness_lease_duration
end

object ROS2DebugBridge
    # B1: identity of the bridge and of the ROS process it runs in.
    property string ros_node_name [readonly]
    property string ros_namespace [readonly]
    property string rmw_implementation [readonly]
    property string bridge_version [readonly]
    # Enabled capability names (PLAN.md 2.5), for example {"read"}.
    property string{list} capabilities [readonly]

    # B4: topics, as in the upstream bridge: a handle, and the object behind
    # it (rostopic_<pkg>__<Msg>.subscriber / .publisher). msgtype is
    # "pkg/Msg" or "pkg/msg/Msg"; empty takes it from the ROS graph. Only
    # topics the exposure rules allow.
    function int32 subscribe(string topic, string msgtype)
    objref varobject{int32} subscribers
    function int32 publish(string topic, string msgtype)
    objref varobject{int32} publishers

    # B6: services, as in the upstream bridge: a handle, and the object
    # behind it (rosservice_<pkg>__<Srv>.rosclient / .rosservice). srvtype
    # is "pkg/Srv" or "pkg/srv/Srv"; for client() empty takes it from the
    # graph. Calling needs a call rule and the call_service capability;
    # register_service (a client serving a ROS service through its
    # servicefunction callback) a serve rule and serve_service.
    function int32 client(string service, string srvtype)
    objref varobject{int32} clients
    function int32 register_service(string service, string srvtype)
    objref varobject{int32} services

    # B8: actions: a handle, and the object behind it
    # (rosaction_<pkg>__<A>.rosactionclient: send_goal generator,
    # wait_for_server). actiontype is "pkg/A" or "pkg/action/A"; empty takes
    # it from the graph. Needs a send rule and the action capability.
    function int32 action_client(string action, string actiontype)
    objref varobject{int32} action_clients

    # B7: parameters of ROS nodes: an
    # experimental.ros2_debug_bridge_parameters.Parameters object (list,
    # describe, get, set, events), in the rcl_interfaces types.
    objref varobject parameters

    # B9: components in ROS component containers: an
    # experimental.ros2_debug_bridge_components.Components object
    # (containers, load, unload, list). Needs the load_component capability.
    objref varobject components

    # B5: graph introspection (read capability). graph is the current view;
    # graph_changes carries each new version.
    property Graph graph [readonly]
    wire Graph graph_changes [readonly]
    function TopicEndpoint{list} topic_endpoints(string topic)
end
