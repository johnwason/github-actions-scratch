service rostopic_sensor_msgs__JointState

stdver 0.10

import rosmsg_sensor_msgs__JointState

object subscriber
    pipe rosmsg_sensor_msgs__JointState.JointState subscriberpipe [readonly]
    wire rosmsg_sensor_msgs__JointState.JointState subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_sensor_msgs__JointState.JointState m)
    pipe rosmsg_sensor_msgs__JointState.JointState publisherpipe [writeonly]
    wire rosmsg_sensor_msgs__JointState.JointState publisherwire [writeonly]
