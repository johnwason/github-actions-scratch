From b6f4ef05e751b9a0f5562ea6986e2dfb8edbe0ed Mon Sep 17 00:00:00 2001
From: John Wason <wason@wasontech.com>
Date: Sun, 15 Nov 2026 15:58:51 -0500
Subject: [PATCH 9/9] CMake: link Windows system libraries with MinGW-w64

The Windows branch listed MSVC import libraries (Mswsock.lib, ...), which
MinGW's linker cannot find. With MinGW, use the lowercase import library
names, and also list the libraries MSVC links by default (advapi32, user32,
shell32, and uuid for the Bluetooth GUIDs in HardwareTransport_win.cpp). The
list was checked against the symbols the static core references when linked
into an executable. The MSVC lists are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 RobotRaconteurCore/CMakeLists.txt | 55 ++++++++++++++++++++-----------
 1 file changed, 35 insertions(+), 20 deletions(-)

diff --git a/RobotRaconteurCore/CMakeLists.txt b/RobotRaconteurCore/CMakeLists.txt
index b5269f7a..0ef1424f 100644
--- a/RobotRaconteurCore/CMakeLists.txt
+++ b/RobotRaconteurCore/CMakeLists.txt
@@ -279,30 +279,45 @@ endif()
 
 if(WIN32)
     target_compile_definitions(RobotRaconteurCore PUBLIC _WIN32_WINNT=0x0600 NOMINMAX=1)
+    if(MINGW)
+        # MinGW-w64 import libraries: lowercase names without .lib; libraries MSVC pulls
+        # in through #pragma comment(lib) or by default are listed explicitly (uuid: the
+        # Bluetooth GUIDs used by HardwareTransport_win.cpp).
+        # cSpell: disable
+        set(RobotRaconteurCore_win_libs
+            mswsock
+            ws2_32
+            iphlpapi
+            bcrypt
+            crypt32
+            advapi32
+            user32
+            shell32
+            uuid)
+        if(NOT ROBOTRACONTEUR_USE_OPENSSL)
+            list(APPEND RobotRaconteurCore_win_libs secur32)
+        endif()
+        # cSpell: enable
+    elseif(ROBOTRACONTEUR_USE_OPENSSL)
+        set(RobotRaconteurCore_win_libs Mswsock.lib ws2_32.lib IPHLPAPI.lib Bcrypt.lib Crypt32.lib)
+    else()
+        # cSpell: disable
+        set(RobotRaconteurCore_win_libs
+            Mswsock.lib
+            ws2_32.lib
+            IPHLPAPI.lib
+            Bcrypt.lib
+            Crypt32.lib
+            Secur32.lib
+            Bcrypt.lib)
+        # cSpell: enable
+    endif()
     if(ROBOTRACONTEUR_USE_OPENSSL)
-        target_link_libraries(
-            RobotRaconteurCore
-            PRIVATE Mswsock.lib
-                    ws2_32.lib
-                    IPHLPAPI.lib
-                    Bcrypt.lib
-                    Crypt32.lib
-                    OpenSSL::SSL
-                    OpenSSL::Crypto)
+        target_link_libraries(RobotRaconteurCore PRIVATE ${RobotRaconteurCore_win_libs} OpenSSL::SSL OpenSSL::Crypto)
         target_compile_definitions(RobotRaconteurCore PRIVATE ROBOTRACONTEUR_USE_OPENSSL)
     else()
-        # cSpell: disable
-        target_link_libraries(
-            RobotRaconteurCore
-            PRIVATE Mswsock.lib
-                    ws2_32.lib
-                    IPHLPAPI.lib
-                    Bcrypt.lib
-                    Crypt32.lib
-                    Secur32.lib
-                    Bcrypt.lib)
+        target_link_libraries(RobotRaconteurCore PRIVATE ${RobotRaconteurCore_win_libs})
         target_compile_definitions(RobotRaconteurCore PRIVATE ROBOTRACONTEUR_USE_SCHANNEL)
-        # cSpell: enable
     endif()
 
     if(CMAKE_COMPILER_IS_GNUCXX)
