service rostopic_sensor_msgs__FluidPressure

stdver 0.10

import rosmsg_sensor_msgs__FluidPressure

object subscriber
    pipe rosmsg_sensor_msgs__FluidPressure.FluidPressure subscriberpipe [readonly]
    wire rosmsg_sensor_msgs__FluidPressure.FluidPressure subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_sensor_msgs__FluidPressure.FluidPressure m)
    pipe rosmsg_sensor_msgs__FluidPressure.FluidPressure publisherpipe [writeonly]
    wire rosmsg_sensor_msgs__FluidPressure.FluidPressure publisherwire [writeonly]
end
