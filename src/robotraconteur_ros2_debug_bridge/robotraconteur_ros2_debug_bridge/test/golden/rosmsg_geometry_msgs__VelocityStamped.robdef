service rosmsg_geometry_msgs__VelocityStamped

stdver 0.10

import rosmsg_std_msgs__Header
import rosmsg_geometry_msgs__Twist

struct VelocityStamped
    field rosmsg_std_msgs__Header.Header header
    field string body_frame_id
    field string reference_frame_id
    field rosmsg_geometry_msgs__Twist.Twist velocity
end
