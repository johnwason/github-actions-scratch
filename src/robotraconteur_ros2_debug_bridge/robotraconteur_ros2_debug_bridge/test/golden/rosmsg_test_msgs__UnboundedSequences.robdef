    field rosmsg_test_msgs__Constants.Constants{list} constants_values
    field rosmsg_test_msgs__Defaults.Defaults{list} defaults_values
    field bool[] bool_values_default
    field uint8[] byte_values_default
    field uint8[] char_values_default
    field single[] float32_values_default
    field double[] float64_values_default
    field int8[] int8_values_default
    field uint8[] uint8_values_default
    field int16[] int16_values_default
    field uint16[] uint16_values_default
    field int32[] int32_values_default
    field uint32[] uint32_values_default
    field int64[] int64_values_default
    field uint64[] uint64_values_default
