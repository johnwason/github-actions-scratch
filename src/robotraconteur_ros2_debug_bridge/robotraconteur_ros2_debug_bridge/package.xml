<?xml version="1.0"?>
<package format="3">
  <name>robotraconteur_ros2_debug_bridge</name>
  <version>0.0.0</version>
  <description>A ROS 2 component that exposes selected topics, services, actions, parameters and the ROS graph of a single-process ROS 2 application over Robot Raconteur, with a deny-by-default exposure policy.</description>
  <maintainer email="wason@wasontech.com">John Wason</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>composition_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rcpputils</depend>
  <depend>rosidl_runtime_c</depend>
  <depend>rosidl_typesupport_introspection_c</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>rmw</depend>
  <depend>std_msgs</depend>
  <depend>yaml_cpp_vendor</depend>
  <!-- Built from GitHub master in the development image (/opt/robotraconteur). -->
  <depend>robotraconteur</depend>

  <test_depend>action_tutorials_interfaces</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>example_interfaces</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>test_msgs</test_depend>
  <test_depend>turtlesim</test_depend>
  <test_depend>class_loader</test_depend>
  <test_depend>demo_nodes_cpp</test_depend>
  <test_depend>rclcpp_action</test_depend>
  <test_depend>rmw_fastrtps_cpp</test_depend>
  <!-- Build-time too, for colcon ordering: the tests locate its library. -->
  <test_depend>rmw_intraprocess_cpp</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
