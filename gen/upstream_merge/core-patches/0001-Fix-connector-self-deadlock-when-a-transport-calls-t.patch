From a455f940d4062528c7d979c188c4f55c09497a46 Mon Sep 17 00:00:00 2001
From: John Wason <wason@wasontech.com>
Date: Sun, 15 Nov 2026 09:36:42 -0500
Subject: [PATCH 1/2] Fix connector self-deadlock when a transport calls the
 connect handler synchronously

RobotRaconteurNode_connector::connect2 held active_lock while calling
Transport::AsyncCreateTransportConnection. LocalTransport connects
synchronously and, if attaching the stream throws, ASIOStreamBaseTransport
invokes the handler synchronously; connected_transport -> handle_error then
locked active_lock again on the same thread. Node shutdown then hung joining
that thread pool thread. Register the attempt key before the call and release
active_lock while calling the transport.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/RobotRaconteurNode_connector.cpp      | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/RobotRaconteurCore/src/RobotRaconteurNode_connector.cpp b/RobotRaconteurCore/src/RobotRaconteurNode_connector.cpp
index 2eec66c1..41d721c0 100644
--- a/RobotRaconteurCore/src/RobotRaconteurNode_connector.cpp
+++ b/RobotRaconteurCore/src/RobotRaconteurNode_connector.cpp
@@ -417,23 +417,30 @@ void RobotRaconteurNode_connector::connect2(const RR_SHARED_PTR<std::vector<std:
             node->RegisterEndpoint(rr_cast<Endpoint>(c));
             RR_SHARED_PTR<endpoint_cleanup> ep = RR_MAKE_SHARED<endpoint_cleanup>(c, node);
 
-            boost::mutex::scoped_lock lock2(active_lock);
-            active_count++;
-            key2 = active_count;
+            {
+                boost::mutex::scoped_lock lock2(active_lock);
+                active_count++;
+                key2 = active_count;
+                active.push_back(key2);
+            }
 
             boost::function<void(const RR_SHARED_PTR<ITransportConnection>&,
                                  const RR_SHARED_PTR<RobotRaconteurException>&)>
                 h = boost::protect(boost::bind(&RobotRaconteurNode_connector::connected_transport, shared_from_this(),
                                                t, RR_BOOST_PLACEHOLDERS(_1), RR_BOOST_PLACEHOLDERS(_2), url, ep, key2));
+            // active_lock must not be held here: transports may invoke the
+            // handler synchronously (for example LocalTransport when attaching
+            // the stream fails), and connected_transport -> handle_error locks
+            // active_lock.
             t->AsyncCreateTransportConnection(url, c, h);
-
-            active.push_back(key2);
         }
         catch (RobotRaconteurException& err2)
         {
             ROBOTRACONTEUR_LOG_DEBUG_COMPONENT(node, Node, -1,
                                                "Error connecting to candidate service url: " << err2.what());
             boost::mutex::scoped_lock lock2(active_lock);
+            if (key2 != 0)
+                active.remove(key2);
             if (urls->empty())
             {
                 lock2.unlock();
@@ -446,6 +453,8 @@ void RobotRaconteurNode_connector::connect2(const RR_SHARED_PTR<std::vector<std:
             ROBOTRACONTEUR_LOG_DEBUG_COMPONENT(node, Node, -1,
                                                "Error connecting to candidate service url: " << err2.what());
             boost::mutex::scoped_lock lock2(active_lock);
+            if (key2 != 0)
+                active.remove(key2);
             if (urls->empty())
             {
                 lock2.unlock();
