	case "com.robotraconteur.testing.TestService3.obj5":
		o, ok := obj.(Obj5)
		if !ok {
			return nil, rr.NewInvalidArgument("object does not implement com.robotraconteur.testing.TestService3.obj5")
		}
		return &obj5Skel{obj: o}, nil
	}
	return nil, rr.NewServiceError("unknown object type " + objectType)
}

func (serviceFactory) DownCastError(e *rr.Error) error {
	switch e.Name {
	case "com.robotraconteur.testing.TestService3.test_exception4":
		return &Test_exception4{E: e}
	}
	return nil
}

func init() {
	rr.AddServiceFactory(Factory)
	rr.RegisterStructureType[Teststruct3]()
	rr.RegisterPodType[Testpod1]()
	rr.RegisterPodType[Testpod2]()
	rr.RegisterNamedArrayType[Vector3, float64]()
	rr.RegisterNamedArrayType[Quaternion, float64]()
	rr.RegisterNamedArrayType[Transform, float64]()
	rr.RegisterNamedArrayType[Pixel, uint8]()
	rr.RegisterNamedArrayType[Pixel2, uint8]()
}
