service rosaction_test_msgs__Fibonacci

stdver 0.10

struct FibonacciGoal
    field int32 order
end

struct FibonacciResult
    field int32[] sequence
end

struct FibonacciFeedback
    field int32[] sequence
end

struct FibonacciGoalStatus
    constant int16 STATUS_UNKNOWN 0
    constant int16 STATUS_ACCEPTED 1
    constant int16 STATUS_EXECUTING 2
    constant int16 STATUS_CANCELING 3
    constant int16 STATUS_SUCCEEDED 4
    constant int16 STATUS_CANCELED 5
    constant int16 STATUS_ABORTED 6
    field uint8[16] goal_id
    field int8 status
    field FibonacciFeedback feedback
    field FibonacciResult result
end

object rosactionclient
    function FibonacciGoalStatus{generator} send_goal(FibonacciGoal goal)
    function bool wait_for_server(double timeout)
end
