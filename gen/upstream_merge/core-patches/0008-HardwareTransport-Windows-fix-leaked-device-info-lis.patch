From d3691fae59bef06fead47ed48d7a1ee36bcb4a37 Mon Sep 17 00:00:00 2001
From: John Wason <wason@wasontech.com>
Date: Sun, 15 Nov 2026 15:58:51 -0500
Subject: [PATCH 8/9] HardwareTransport (Windows): fix leaked device info
 lists; build with MinGW-w64

- Two SetupDiGetClassDevsW results were wrapped as
  RR_SHARED_PTR<void>(deviceInfo_sp, f->SetupDiDestroyDeviceInfoList): the
  empty shared_ptr was passed instead of the handle. MSVC converts the
  function pointer to void* and picks the aliasing constructor, so the list
  was never destroyed (handle leak on every Bluetooth/USB scan). GCC rejects
  it. Wrap the handle with the same deleter the other two call sites use.
- PBTH_ADDR is not defined by MinGW-w64; use BTH_ADDR*.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 RobotRaconteurCore/src/HardwareTransport_win.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/RobotRaconteurCore/src/HardwareTransport_win.cpp b/RobotRaconteurCore/src/HardwareTransport_win.cpp
index ff79197f..b767f171 100644
--- a/RobotRaconteurCore/src/HardwareTransport_win.cpp
+++ b/RobotRaconteurCore/src/HardwareTransport_win.cpp
@@ -1204,7 +1204,8 @@ static BOOL DoRegisterBluetoothRadioToHwd(const RR_SHARED_PTR<void>& f, HWND hWn
         return FALSE;
     }
 
-    deviceInfo_sp = RR_SHARED_PTR<void>(deviceInfo_sp, setupapi_f->SetupDiDestroyDeviceInfoList);
+    deviceInfo_sp = RR_SHARED_PTR<void>(deviceInfo, boost::bind(&SetupApi_Functions_SetupDiDestroyDeviceInfoList,
+                                                                setupapi_f, RR_BOOST_PLACEHOLDERS(_1)));
 
     interfaceData.cbSize = sizeof(SP_DEVICE_INTERFACE_DATA);
 
@@ -1426,7 +1427,7 @@ void HardwareTransport_win_discovery::OnBluetoothChanged_win(GUID guid, DWORD ev
             SOCKADDR_BTH addr;
             ZeroMemory(&addr, sizeof(addr));
             addr.addressFamily = AF_BTH;
-            addr.btAddr = *reinterpret_cast<PBTH_ADDR>(buf);
+            addr.btAddr = *reinterpret_cast<BTH_ADDR*>(buf);
 
             return;
         }
@@ -1520,7 +1521,8 @@ std::list<boost::tuple<NodeID, std::string> > HardwareTransport_win_find_devicei
         return o;
     }
 
-    deviceInfo_sp = RR_SHARED_PTR<void>(deviceInfo_sp, f1->SetupDiDestroyDeviceInfoList);
+    deviceInfo_sp = RR_SHARED_PTR<void>(
+        deviceInfo, boost::bind(&SetupApi_Functions_SetupDiDestroyDeviceInfoList, f1, RR_BOOST_PLACEHOLDERS(_1)));
 
     interfaceData.cbSize = sizeof(SP_DEVICE_INTERFACE_DATA);
 
