# ThreadSanitizer suppressions for the *reference RMW* (rmw_fastrtps_cpp) test
# instances only. These processes never load rmw_intraprocess_cpp, so nothing
# here can hide a race in this RMW. Approved by the user 2026-11-13
# ("suppress by library"); docs/unsupported.md.

# Same rosbag2_cpp internal race as scripts/in-container/tsan.supp.
race:librosbag2_cpp.so

# Fast DDS payload pool: two Fast DDS threads serialize/deserialize into the same
# pooled payload (TopicPayloadPool); only libfastcdr frames are visible because
# TSan cannot unwind through the prebuilt Fast DDS library. Not suppressed
# globally: rmw_intraprocess_cpp also uses libfastcdr.
race:libfastcdr.so

# rclcpp graph listener thread releases an rclcpp::Event (NodeGraph::
# notify_graph_change) while the test drops its shared_ptr to it: shared_ptr
# refcount atomics inside the uninstrumented librclcpp are invisible to TSan.
# Narrowed to this function (not librclcpp.so: nearly every stack in the rclcpp
# tests passes through rclcpp before reaching this RMW). No rmw_intraprocess
# frames. Seen intermittently in test_rclcpp_graph on the GitHub TSan runner.
# Same user decision as the entries above (upstream races suppressed narrowly).
race:rclcpp::node_interfaces::NodeGraph::notify_graph_change

# rclcpp MultiThreadedExecutor workers during an entity recollect (nodes added
# by rclcpp_components::ComponentManager): one worker frees an object another
# worker used under a mutex in NodeBase::callback_group_in_node; the ordering is
# a shared_ptr refcount inside the uninstrumented librclcpp. Both stacks are
# entirely in librclcpp, no rmw_intraprocess or test frames. Seen
# intermittently in test_composition_demo on the GitHub TSan runner. Same user
# decision as the entries above (upstream races suppressed narrowly).
race:rclcpp::node_interfaces::NodeBase::callback_group_in_node

# rclcpp: a MultiThreadedExecutor worker frees a callback group's notify guard
# condition while another worker triggers it
# (CallbackGroup::trigger_notify_guard_condition -> GuardCondition::trigger).
# Both stacks entirely in librclcpp, no rmw_intraprocess or test frames. Seen
# intermittently in test_composition_demo on the GitHub TSan runner
# (2026-11-14). Same user decision as the entries above.
race:rclcpp::CallbackGroup::trigger_notify_guard_condition
