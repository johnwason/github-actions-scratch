service rostopic_turtlesim__Color

stdver 0.10

import rosmsg_turtlesim__Color

object subscriber
    pipe rosmsg_turtlesim__Color.Color subscriberpipe [readonly]
    wire rosmsg_turtlesim__Color.Color subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_turtlesim__Color.Color m)
    pipe rosmsg_turtlesim__Color.Color publisherpipe [writeonly]
    wire rosmsg_turtlesim__Color.Color publisherwire [writeonly]
end
