service rostopic_sensor_msgs__Illuminance

stdver 0.10

import rosmsg_sensor_msgs__Illuminance

object subscriber
    pipe rosmsg_sensor_msgs__Illuminance.Illuminance subscriberpipe [readonly]
    wire rosmsg_sensor_msgs__Illuminance.Illuminance subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_sensor_msgs__Illuminance.Illuminance m)
    pipe rosmsg_sensor_msgs__Illuminance.Illuminance publisherpipe [writeonly]
    wire rosmsg_sensor_msgs__Illuminance.Illuminance publisherwire [writeonly]
end
