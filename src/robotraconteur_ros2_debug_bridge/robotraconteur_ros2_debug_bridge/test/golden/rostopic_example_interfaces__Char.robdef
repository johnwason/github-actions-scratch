service rostopic_example_interfaces__Char

stdver 0.10

import rosmsg_example_interfaces__Char

object subscriber
    pipe rosmsg_example_interfaces__Char.Char subscriberpipe [readonly]
    wire rosmsg_example_interfaces__Char.Char subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_example_interfaces__Char.Char m)
    pipe rosmsg_example_interfaces__Char.Char publisherpipe [writeonly]
    wire rosmsg_example_interfaces__Char.Char publisherwire [writeonly]
end
