service rostopic_test_msgs__Defaults

stdver 0.10

import rosmsg_test_msgs__Defaults

object subscriber
    pipe rosmsg_test_msgs__Defaults.Defaults subscriberpipe [readonly]
    wire rosmsg_test_msgs__Defaults.Defaults subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_test_msgs__Defaults.Defaults m)
    pipe rosmsg_test_msgs__Defaults.Defaults publisherpipe [writeonly]
    wire rosmsg_test_msgs__Defaults.Defaults publisherwire [writeonly]
