// Obj5DefaultImpl is a default implementation of Obj5 for services.
// Embed it in a struct and override the members to implement.
// Properties are stored in memory, functions and objrefs return
// NotImplementedError, readonly pipes and wires get broadcasters
// (RRBroadcaster_<member>) and writeonly wires get unicast receivers
// (RRReceiver_<member>).
type Obj5DefaultImpl struct {
	rr__mu sync.Mutex
	rr_p1 float64
	rr_p2 float64
	rr_p3 float64
	rr_q1 *rr.Pipe[int32]
	// RRBroadcaster_q1 sends packets to all clients connected to q1.
	RRBroadcaster_q1 *rr.PipeBroadcaster[int32]
	rr_q2 *rr.Pipe[int32]
	// RRBroadcaster_q2 sends packets to all clients connected to q2.
	RRBroadcaster_q2 *rr.PipeBroadcaster[int32]
	rr_w1 *rr.Wire[int32]
	// RRBroadcaster_w1 sends the value of w1 to all clients.
	RRBroadcaster_w1 *rr.WireBroadcaster[int32]
	rr_w2 *rr.Wire[int32]
	// RRBroadcaster_w2 sends the value of w2 to all clients.
	RRBroadcaster_w2 *rr.WireBroadcaster[int32]
}

var _ Obj5 = (*Obj5DefaultImpl)(nil)

func (rr_s *Obj5DefaultImpl) Get_p1(rr_ctx context.Context) (float64, error) {
	rr_s.rr__mu.Lock()
	defer rr_s.rr__mu.Unlock()
	return rr_s.rr_p1, nil
}

