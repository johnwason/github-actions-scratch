service rosaction_turtlesim__RotateAbsolute

stdver 0.10

struct RotateAbsoluteGoal
    field single theta
end

struct RotateAbsoluteResult
    field single delta
end

struct RotateAbsoluteFeedback
    field single remaining
end

struct RotateAbsoluteGoalStatus
    constant int16 STATUS_UNKNOWN 0
    constant int16 STATUS_ACCEPTED 1
    constant int16 STATUS_EXECUTING 2
    constant int16 STATUS_CANCELING 3
    constant int16 STATUS_SUCCEEDED 4
    constant int16 STATUS_CANCELED 5
    constant int16 STATUS_ABORTED 6
    field uint8[16] goal_id
    field int8 status
    field RotateAbsoluteFeedback feedback
    field RotateAbsoluteResult result
end

object rosactionclient
    function RotateAbsoluteGoalStatus{generator} send_goal(RotateAbsoluteGoal goal)
    function bool wait_for_server(double timeout)
end
