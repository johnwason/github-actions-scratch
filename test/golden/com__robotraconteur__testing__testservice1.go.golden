func (rr_s *testrootStub) RRDispatchEvent(rr_name string, rr_args []*rr.Element) {
	switch rr_name {
	case "ev1":
		for _, rr_h := range rr_s.rr_ev1.Handlers() {
			rr_h()
		}
	case "ev2":
		d1, rr_err := rr.UnpackField(rr_args, "d1", rr.ScalarCodec[float64]())
		if rr_err != nil {
			return
		}
		s2, rr_err := rr.UnpackField(rr_args, "s2", rr.StructureCodec[Teststruct2]())
		if rr_err != nil {
			return
		}
		for _, rr_h := range rr_s.rr_ev2.Handlers() {
			rr_h(d1, s2)
		}
	}
	_ = rr_args
}

func (rr_s *testrootStub) RRCallbackCall(rr_name string, rr_args []*rr.Element) (*rr.Element, error) {
	switch rr_name {
	case "cb1":
		rr_f, rr_ok := rr_s.rr_cb1.Function()
		if !rr_ok {
			return nil, rr.NewInvalidOperation("callback cb1 not set")
		}
		return nil, rr_f()
	case "cb2":
		rr_f, rr_ok := rr_s.rr_cb2.Function()
		if !rr_ok {
			return nil, rr.NewInvalidOperation("callback cb2 not set")
		}
		d1, rr_err := rr.UnpackField(rr_args, "d1", rr.ScalarCodec[float64]())
		if rr_err != nil {
			return nil, rr_err
		}
		d2, rr_err := rr.UnpackField(rr_args, "d2", rr.ScalarCodec[float64]())
		if rr_err != nil {
			return nil, rr_err
		}
		return nil, rr_f(d1, d2)
	case "cb3":
		rr_f, rr_ok := rr_s.rr_cb3.Function()
		if !rr_ok {
			return nil, rr.NewInvalidOperation("callback cb3 not set")
		}
		d1, rr_err := rr.UnpackField(rr_args, "d1", rr.ScalarCodec[float64]())
		if rr_err != nil {
			return nil, rr_err
		}
		d2, rr_err := rr.UnpackField(rr_args, "d2", rr.ScalarCodec[float64]())
		if rr_err != nil {
			return nil, rr_err
		}
		rr_ret, rr_err := rr_f(d1, d2)
		if rr_err != nil {
			return nil, rr_err
		}
		return rr.ScalarCodec[float64]().Pack("return", rr_ret)
	case "cb_meaning_of_life":
		rr_f, rr_ok := rr_s.rr_cb_meaning_of_life.Function()
		if !rr_ok {
			return nil, rr.NewInvalidOperation("callback cb_meaning_of_life not set")
		}
		rr_ret, rr_err := rr_f()
		if rr_err != nil {
			return nil, rr_err
		}
		return rr.ScalarCodec[int32]().Pack("return", rr_ret)
	case "cb_errtest":
		rr_f, rr_ok := rr_s.rr_cb_errtest.Function()
		if !rr_ok {
			return nil, rr.NewInvalidOperation("callback cb_errtest not set")
		}
		return nil, rr_f()
	}
	_ = rr_args
	return nil, rr.NewMemberNotFound("callback " + rr_name + " not found")
}

type testrootSkel struct {
	obj Testroot
	aobj AsyncTestroot
	b   *rr.SkelBase
}

func (rr_s *testrootSkel) RRInit(rr_b *rr.SkelBase) error {
	rr_s.b = rr_b
	if rr_ev := rr_s.obj.Ev1(); rr_ev != nil {
		rr_b.RRAddEventConnection(rr_ev.Connect(func() {
			var rr_b2 rr.ElementBuilder
			_ = rr_b.DispatchEvent("ev1", &rr_b2)
		}))
	}
	if rr_ev := rr_s.obj.Ev2(); rr_ev != nil {
		rr_b.RRAddEventConnection(rr_ev.Connect(func(d1 float64, s2 *Teststruct2) {
			var rr_b2 rr.ElementBuilder
			rr.PackField(&rr_b2, "d1", d1, rr.ScalarCodec[float64]())
			rr.PackField(&rr_b2, "s2", s2, rr.StructureCodec[Teststruct2]())
			_ = rr_b.DispatchEvent("ev2", &rr_b2)
		}))
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "p1", rr.ArrayCodec[float64](0, false)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ SetP1(*rr.Pipe[[]float64]) }); rr_ok {
		rr_set.SetP1(rr_p)
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "p2", rr.StructureCodec[Teststruct2]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ SetP2(*rr.Pipe[*Teststruct2]) }); rr_ok {
		rr_set.SetP2(rr_p)
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "broadcastpipe", rr.ScalarCodec[float64]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ SetBroadcastpipe(*rr.Pipe[float64]) }); rr_ok {
		rr_set.SetBroadcastpipe(rr_p)
	}
	if rr_cb := rr_s.obj.Cb1(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func() error, error) {
			return func() error {
				var rr_b2 rr.ElementBuilder
				_, rr_err := rr_b.CallbackCall("cb1", rr_ep, &rr_b2)
				return rr_err
			}, nil
		})
	}
	if rr_cb := rr_s.obj.Cb2(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func(d1 float64, d2 float64) error, error) {
			return func(d1 float64, d2 float64) error {
				var rr_b2 rr.ElementBuilder
				rr.PackField(&rr_b2, "d1", d1, rr.ScalarCodec[float64]())
				rr.PackField(&rr_b2, "d2", d2, rr.ScalarCodec[float64]())
				_, rr_err := rr_b.CallbackCall("cb2", rr_ep, &rr_b2)
				return rr_err
			}, nil
		})
	}
	if rr_cb := rr_s.obj.Cb3(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func(d1 float64, d2 float64) (float64, error), error) {
			return func(d1 float64, d2 float64) (float64, error) {
				var rr_b2 rr.ElementBuilder
				rr.PackField(&rr_b2, "d1", d1, rr.ScalarCodec[float64]())
				rr.PackField(&rr_b2, "d2", d2, rr.ScalarCodec[float64]())
				rr_ret, rr_err := rr_b.CallbackCall("cb3", rr_ep, &rr_b2)
				if rr_err != nil {
					var rr_zero float64
					return rr_zero, rr_err
				}
				return rr.UnpackReturn(rr_ret, rr.ScalarCodec[float64]())
			}, nil
		})
	}
	if rr_cb := rr_s.obj.Cb_meaning_of_life(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func() (int32, error), error) {
			return func() (int32, error) {
				var rr_b2 rr.ElementBuilder
				rr_ret, rr_err := rr_b.CallbackCall("cb_meaning_of_life", rr_ep, &rr_b2)
				if rr_err != nil {
					var rr_zero int32
					return rr_zero, rr_err
				}
				return rr.UnpackReturn(rr_ret, rr.ScalarCodec[int32]())
			}, nil
		})
	}
	if rr_cb := rr_s.obj.Cb_errtest(); rr_cb != nil {
		rr_cb.RRSetClientFunctionSource(func(rr_ep uint32) (func() error, error) {
			return func() error {
				var rr_b2 rr.ElementBuilder
				_, rr_err := rr_b.CallbackCall("cb_errtest", rr_ep, &rr_b2)
				return rr_err
			}, nil
		})
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w1", rr.ArrayCodec[float64](0, false)); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ SetW1(*rr.Wire[[]float64]) }); rr_ok {
		rr_set.SetW1(rr_w)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w2", rr.StructureCodec[Teststruct2]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ SetW2(*rr.Wire[*Teststruct2]) }); rr_ok {
		rr_set.SetW2(rr_w)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w3", rr.MultiDimArrayCodec[int32]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ SetW3(*rr.Wire[*rr.MultiDimArray[int32]]) }); rr_ok {
		rr_set.SetW3(rr_w)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "broadcastwire", rr.ScalarCodec[float64]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ SetBroadcastwire(*rr.Wire[float64]) }); rr_ok {
		rr_set.SetBroadcastwire(rr_w)
	}
	return nil
}

