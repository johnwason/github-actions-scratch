 RobotRaconteurCore/src/TcpTransport.cpp                       | 4 ++--
 RobotRaconteurCore/src/TlsSchannelStreamAdapter.cpp           | 2 +-
 RobotRaconteurCore/src/boost_asio_win_unix_sockets_backport.h | 2 +-
 9 files changed, 13 insertions(+), 13 deletions(-)

