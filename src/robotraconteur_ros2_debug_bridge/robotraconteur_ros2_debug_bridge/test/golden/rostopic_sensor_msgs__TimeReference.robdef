service rostopic_sensor_msgs__TimeReference

stdver 0.10

import rosmsg_sensor_msgs__TimeReference

object subscriber
    pipe rosmsg_sensor_msgs__TimeReference.TimeReference subscriberpipe [readonly]
    wire rosmsg_sensor_msgs__TimeReference.TimeReference subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_sensor_msgs__TimeReference.TimeReference m)
    pipe rosmsg_sensor_msgs__TimeReference.TimeReference publisherpipe [writeonly]
    wire rosmsg_sensor_msgs__TimeReference.TimeReference publisherwire [writeonly]
end
