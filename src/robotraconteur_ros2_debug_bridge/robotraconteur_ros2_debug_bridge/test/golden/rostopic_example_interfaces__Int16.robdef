service rostopic_example_interfaces__Int16

stdver 0.10

import rosmsg_example_interfaces__Int16

object subscriber
    pipe rosmsg_example_interfaces__Int16.Int16 subscriberpipe [readonly]
    wire rosmsg_example_interfaces__Int16.Int16 subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_example_interfaces__Int16.Int16 m)
    pipe rosmsg_example_interfaces__Int16.Int16 publisherpipe [writeonly]
    wire rosmsg_example_interfaces__Int16.Int16 publisherwire [writeonly]
end
