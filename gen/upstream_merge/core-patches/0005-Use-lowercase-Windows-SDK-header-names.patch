 RobotRaconteurCore/src/HardwareTransport.cpp                  | 2 +-
 RobotRaconteurCore/src/HardwareTransport_win_private.h        | 4 ++--
 RobotRaconteurCore/src/LocalTransport.cpp                     | 2 +-
