service rostopic_example_interfaces__Int8

stdver 0.10

import rosmsg_example_interfaces__Int8

object subscriber
    pipe rosmsg_example_interfaces__Int8.Int8 subscriberpipe [readonly]
    wire rosmsg_example_interfaces__Int8.Int8 subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_example_interfaces__Int8.Int8 m)
    pipe rosmsg_example_interfaces__Int8.Int8 publisherpipe [writeonly]
    wire rosmsg_example_interfaces__Int8.Int8 publisherwire [writeonly]
