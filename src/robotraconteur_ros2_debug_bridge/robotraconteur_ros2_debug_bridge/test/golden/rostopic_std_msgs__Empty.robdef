service rostopic_std_msgs__Empty

stdver 0.10

import rosmsg_std_msgs__Empty

object subscriber
    pipe rosmsg_std_msgs__Empty.Empty subscriberpipe [readonly]
    wire rosmsg_std_msgs__Empty.Empty subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_std_msgs__Empty.Empty m)
    pipe rosmsg_std_msgs__Empty.Empty publisherpipe [writeonly]
    wire rosmsg_std_msgs__Empty.Empty publisherwire [writeonly]
end
