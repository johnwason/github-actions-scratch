service rosmsg_sensor_msgs__MagneticField

stdver 0.10

import rosmsg_std_msgs__Header
import rosmsg_geometry_msgs__Vector3

struct MagneticField
    field rosmsg_std_msgs__Header.Header header
    field rosmsg_geometry_msgs__Vector3.Vector3 magnetic_field
    field double[9] magnetic_field_covariance
end
