service rostopic_example_interfaces__String

stdver 0.10

import rosmsg_example_interfaces__String

object subscriber
    pipe rosmsg_example_interfaces__String.String subscriberpipe [readonly]
    wire rosmsg_example_interfaces__String.String subscriberwire [readonly]
    function void unsubscribe()
end

object publisher
    function void publish(rosmsg_example_interfaces__String.String m)
    pipe rosmsg_example_interfaces__String.String publisherpipe [writeonly]
    wire rosmsg_example_interfaces__String.String publisherwire [writeonly]
end
