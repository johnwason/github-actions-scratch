}

func (rr_s *obj5Skel) RRInit(rr_b *rr.SkelBase) error {
	rr_s.b = rr_b
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "q1", rr.ScalarCodec[int32]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_q1(*rr.Pipe[int32]) }); rr_ok {
		rr_set.Set_q1(rr_p)
	}
	if rr_p, rr_err := rr.NewPipeServer(rr_b, "q2", rr.ScalarCodec[int32]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_q2(*rr.Pipe[int32]) }); rr_ok {
		rr_set.Set_q2(rr_p)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w1", rr.ScalarCodec[int32]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_w1(*rr.Wire[int32]) }); rr_ok {
		rr_set.Set_w1(rr_w)
	}
	if rr_w, rr_err := rr.NewWireServer(rr_b, "w2", rr.ScalarCodec[int32]()); rr_err != nil {
		return rr_err
	} else if rr_set, rr_ok := rr_s.obj.(interface{ Set_w2(*rr.Wire[int32]) }); rr_ok {
		rr_set.Set_w2(rr_w)
	}
	return nil
}

